# Settings for the billing agent. Copy to .env and fill in; .env is never committed.
# Every setting is explained in docs/technical-design.md and docs/integrations/*.

# --- The agent ---------------------------------------------------------------
# dry_run is the stop button: nothing goes to a client, nothing is created in
# QuickBooks, whatever a command-line flag asks for. Start here.
FOPS_MODE=dry_run
# Icon's timezone (required; "today" and billing periods are worked out in it).
FOPS_TIMEZONE=America/New_York
# Where the database, stored attachments, invoice PDFs, and the tracking sheet live.
FOPS_DATA_DIR=data
# The engagement list Kevin keeps (an .xlsx file, or a folder of CSVs).
FOPS_ENGAGEMENT_LIST=data/engagements.xlsx
# Kevin: gets every email the agent writes, and is on CC of every client email.
FOPS_ADMIN_EMAIL=kevin@icon-technologies.com
# The agent's own mailbox. Must match MAIL_USERNAME below.
FOPS_AGENT_MAILBOX=jay@icon-technologies.com
# The Claude model that reads timesheets, and the key for it.
FOPS_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- The agent's mailbox at Rackspace Email (docs/integrations/email-imap-smtp.md)
# Defaults are Rackspace's: secure.emailsrvr.com, IMAP 993 (ssl), SMTP 465 (ssl).
# Security is ssl, starttls, or none; none is refused for anything but a test
# server on this machine.
MAIL_IMAP_HOST=secure.emailsrvr.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=ssl
MAIL_SMTP_HOST=secure.emailsrvr.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=ssl
# The agent's address and its mailbox password (from the Rackspace control panel).
MAIL_USERNAME=jay@icon-technologies.com
MAIL_PASSWORD=
# Mail that arrived before this date is left alone (YYYY-MM-DD). Blank = the
# date of the first run, which the agent remembers.
MAIL_START_DATE=
# Parent of the Processed, Needs Review, and Ignored folders in the mailbox.
MAIL_FOLDER_PREFIX=Agent
# Where copies of sent mail go. Blank = the folder the server marks as Sent, else "Sent".
MAIL_SENT_FOLDER=

# --- Accounting --------------------------------------------------------------
# manual: the agent numbers and renders the invoice PDF and Kevin enters it into
# QuickBooks by hand. quickbooks: QuickBooks Online (docs/integrations/quickbooks-online.md).
FOPS_ACCOUNTING=manual
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# sandbox until the real company is connected (roadmap PR 16).
QBO_ENVIRONMENT=sandbox
# The service item invoices are written against.
QBO_ITEM_NAME=Consulting Services

# --- Running as a service (fops serve, roadmap PR 14) ------------------------
FOPS_RUN_EVERY_MINUTES=15
FOPS_BACKUP_AT=02:30
# A heartbeat URL (for example healthchecks.io) pinged after every successful run and backup.
FOPS_HEARTBEAT_URL=
# An rclone remote path the nightly backup is copied to, e.g. b2:icon-fops-backups
FOPS_BACKUP_TARGET=
